{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jopuja-live-connect",
  "main": "src/index.js",
  "compatibility_date": "2026-09-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_HUB",
        "class_name": "LiveHub"
      },
      {
        "name": "AUTH_CRYPTO",
        "class_name": "AuthCrypto"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveHub",
        "AuthCrypto"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "17 3 * * *"
    ]
  },
  "vars": {
    "APP_NAME": "JOPUJA LIVE CONNECT",
    "APP_VERSION": "2.1.0",
    "BRAND_OWNER": "JOPUJA FOUNDER",
    "BRAND_CREDIT": "Jopuja Digital™"
  }
}
